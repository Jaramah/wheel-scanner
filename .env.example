# ─────────────────────────────────────────────────────────────────────────────
# .env.example  —  Copy to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Binance API credentials ───────────────────────────────────────────────────
# Create keys at https://testnet.binancefuture.com  (testnet)
# or  https://www.binance.com/en/my/settings/api-management  (live)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# ── Trading mode ──────────────────────────────────────────────────────────────
# DRY_RUN=true  → no orders placed, simulated balance, live market data (best for testing)
# SANDBOX_MODE=true  → Binance testnet (deprecated — use DRY_RUN instead)
# SANDBOX_MODE=false → live account (real money)
DRY_RUN=true
DRY_RUN_BALANCE=1000.0         # simulated USDT equity when DRY_RUN=true
SANDBOX_MODE=false

# Leverage multiplier (1–125 on Binance Futures).
# MAX_LEVERAGE acts as a hard cap — the bot will clamp LEVERAGE down to this value
# and log a warning if LEVERAGE exceeds it.  Keeps accidental high-leverage configs safe.
LEVERAGE=5
MAX_LEVERAGE=20

# ── Claude / OpenClaw local proxy ─────────────────────────────────────────────
CLAUDE_API_URL=http://localhost:8000/v1/chat/completions
CLAUDE_MODEL=claude-3-5-sonnet-20241022
CLAUDE_TIMEOUT=30

# API key forwarded to OpenClaw (may be "local" if your proxy doesn't verify it)
OPENAI_API_KEY=local

# ── Telegram bot alerts ───────────────────────────────────────────────────────
# 1. Talk to @BotFather on Telegram to create a bot and get the token.
# 2. Add the bot to a private channel / group, then get the chat ID.
#    Easiest way: https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=<YOUR_TELEGRAM_BOT_TOKEN>
TELEGRAM_CHAT_ID=<YOUR_TELEGRAM_CHAT_ID>

# ── Risk parameters ───────────────────────────────────────────────────────────
RISK_PER_TRADE_PCT=0.01      # 1.0% of equity per trade
TRAILING_STOP_PCT=0.005      # 0.5% trailing stop distance
# Daily loss limit as a fraction of account equity at startup.
# 0.03 = 3% — scales correctly regardless of account size.
# Example: $10k account → $300 daily limit; $500 account → $15 daily limit.
DAILY_LOSS_LIMIT_PCT=0.03
SLIPPAGE_LIMIT_PCT=0.001     # Skip trade if live price drifted > 0.1% from candle close

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_FILE=trading_bot.log
