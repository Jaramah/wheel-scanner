# ─────────────────────────────────────────────────────────────────────────────
# .env.example  —  Copy to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Binance API credentials ───────────────────────────────────────────────────
# Create keys at https://testnet.binancefuture.com  (testnet)
# or  https://www.binance.com/en/my/settings/api-management  (live)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# ── Trading mode ──────────────────────────────────────────────────────────────
# true  = Binance Futures Testnet (paper money — SAFE to start here)
# false = Live account (real money — only after thorough paper testing)
SANDBOX_MODE=true

# Leverage multiplier applied to every position (1–125 on Binance Futures)
LEVERAGE=5

# ── Claude / OpenClaw local proxy ─────────────────────────────────────────────
CLAUDE_API_URL=http://localhost:8000/v1/chat/completions
CLAUDE_MODEL=claude-3-5-sonnet-20241022
CLAUDE_TIMEOUT=30

# API key forwarded to OpenClaw (may be "local" if your proxy doesn't verify it)
OPENAI_API_KEY=local

# ── Telegram bot alerts ───────────────────────────────────────────────────────
# 1. Talk to @BotFather on Telegram to create a bot and get the token.
# 2. Add the bot to a private channel / group, then get the chat ID.
#    Easiest way: https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=123456789:ABCDefghIJKLmnopQRSTuvwxYZ
TELEGRAM_CHAT_ID=-1001234567890

# ── Risk parameters ───────────────────────────────────────────────────────────
RISK_PER_TRADE_PCT=0.01      # 1.0% of equity per trade
TRAILING_STOP_PCT=0.005      # 0.5% trailing stop distance
DAILY_LOSS_LIMIT_USD=100.0   # Circuit breaker fires at $100 daily loss
SLIPPAGE_LIMIT_PCT=0.001     # Skip trade if live price drifted > 0.1% from candle close

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_FILE=trading_bot.log
